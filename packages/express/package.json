{
  "name": "@schmock/express",
  "version": "2.3.1",
  "description": "Express adapter for Schmock mock API generator",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khalic-lab/schmock.git",
    "directory": "packages/express"
  },
  "homepage": "https://github.com/khalic-lab/schmock/tree/main/packages/express#readme",
  "bugs": {
    "url": "https://github.com/khalic-lab/schmock/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist && rm -f tsconfig.tsbuildinfo",
    "build": "bun run clean && bun run build:lib && bun run build:types",
    "build:lib": "bun build --minify --target node --format esm --outdir=dist src/index.ts --external @schmock/core --external express",
    "build:types": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:bdd": "vitest run --config vitest.config.bdd.ts",
    "lint": "biome check src/",
    "lint:fix": "biome check --write --unsafe src/",
    "check:publish": "publint && attw --pack --ignore-rules cjs-resolves-to-esm"
  },
  "dependencies": {},
  "devDependencies": {
    "@amiceli/vitest-cucumber": "^7.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.0",
    "express": "^5.2.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "peerDependencies": {
    "@schmock/core": "^2.3.1",
    "express": "^4.18.0 || ^5.0.0"
  },
  "keywords": [
    "mock",
    "api",
    "express",
    "testing",
    "development"
  ],
  "author": "Khalic Lab",
  "license": "MIT"
}
