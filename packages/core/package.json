{
  "name": "@schmock/core",
  "description": "Core functionality for Schmock",
  "version": "2.4.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khalic-lab/schmock.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/khalic-lab/schmock/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/khalic-lab/schmock/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf dist && rm -f tsconfig.tsbuildinfo",
    "build": "bun run clean && bun run build:lib && bun run build:types",
    "build:lib": "tsc -p tsconfig.runtime.json",
    "build:types": "rm -f tsconfig.tsbuildinfo && tsc --build && node scripts/embed-ambient-types.js",
    "pretest": "rm -f src/*.js src/*.d.ts || true",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "pretest:bdd": "rm -f src/*.js src/*.d.ts || true",
    "test:bdd": "vitest run --config vitest.config.bdd.ts",
    "lint": "biome check src/*.ts",
    "lint:fix": "biome check --write --unsafe src/*.ts",
    "check:publish": "publint && attw --pack --ignore-rules cjs-resolves-to-esm"
  },
  "license": "MIT",
  "dependencies": {
    "@types/json-schema": "^7.0.15"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "^7.0.0",
    "@types/node": "^26.1.0",
    "vitest": "^4.1.9"
  }
}
