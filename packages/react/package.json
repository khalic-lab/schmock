{
  "name": "@schmock/react",
  "version": "2.4.0",
  "description": "React adapter for Schmock — Provider, hooks, and test utilities",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khalic-lab/schmock.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/khalic-lab/schmock/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/khalic-lab/schmock/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "clean": "rm -rf dist && rm -f tsconfig.tsbuildinfo",
    "build": "bun run clean && bun run build:lib && bun run build:types",
    "build:lib": "bun build --minify --target browser --outdir=dist src/index.ts src/testing.ts --external @schmock/core --external react --external @testing-library/react --external './index.*'",
    "build:types": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:bdd": "vitest run --config vitest.config.bdd.ts",
    "lint": "biome check src/",
    "lint:fix": "biome check --write --unsafe src/",
    "check:publish": "publint && attw --pack --ignore-rules cjs-resolves-to-esm"
  },
  "license": "MIT",
  "dependencies": {},
  "peerDependencies": {
    "@schmock/core": "^2.4.0",
    "react": "^18.0.0 || ^19.0.0",
    "@testing-library/react": "^16.0.0"
  },
  "peerDependenciesMeta": {
    "@testing-library/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vitest": "^4.1.9"
  },
  "keywords": [
    "schmock",
    "mock",
    "react",
    "testing",
    "api"
  ],
  "author": "Khalic Lab"
}
