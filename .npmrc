# @schmock/* are public packages and belong on the public registry.
#
# This file exists because a machine-level ~/.npmrc can set `registry=` to
# something else entirely — a corporate Artifactory, a mirror — and npm and bun
# both honour it. Without this, `npm publish` from a checkout would target
# whatever the machine happens to point at, and `npm view` would answer from
# there too, which is what the release script's "already published?" guard
# reads. Each package also carries `publishConfig.registry`, which travels
# inside the tarball and holds even when a publish runs from outside this
# directory.
registry=https://registry.npmjs.org/
@schmock:registry=https://registry.npmjs.org/
