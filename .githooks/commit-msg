#!/bin/sh
# Conventional Commit validation hook
# Format: type(scope): description
# Types: feat, fix, docs, style, refactor, perf, test, chore, ci, build, revert

commit_regex='^(feat|fix|docs|style|refactor|perf|test|chore|ci|build|revert)(\(.+\))?: .+'
merge_regex='^Merge (branch|pull request)'

error_msg="Commit message format error!

Your commit message should follow the Conventional Commits specification:
  type(scope): description

Valid types: feat, fix, docs, style, refactor, perf, test, chore, ci, build, revert

Examples:
  feat: add user authentication
  fix(api): resolve timeout issue
  docs: update README with examples
  chore: bump dependencies"

# Check the subject only: a conventional-looking line in the body must not
# pass for one. Git runs this hook before it strips comment lines and leading
# blank lines, so the subject is the first line that is neither. Comments start
# with core.commentString or core.commentChar (default "#"); with "auto", git
# picks one of the characters listed below, so treat all of them as comments.
comment=$(git config core.commentString 2>/dev/null ||
    git config core.commentChar 2>/dev/null || echo '#')
case "$comment" in
    "" | auto) comment='#;@!$%^&|:' ; auto=1 ;;
    *) auto=0 ;;
esac
subject=$(awk -v c="$comment" -v auto="$auto" '
    /^[[:space:]]*$/ { next }
    auto == 1 && index(c, substr($0, 1, 1)) > 0 { next }
    auto == 0 && index($0, c) == 1 { next }
    { print; exit }
' "$1")

# `git commit --fixup`, `--squash` and `--fixup=amend:`/`reword:` prefix the
# target's subject with "fixup! ", "squash! " or "amend! " (stacked when the
# target is itself one), and `rebase --autosquash` drops the prefix. Judge the
# subject that will remain.
while :; do
    case "$subject" in
        "fixup! "* | "squash! "* | "amend! "*) subject=${subject#*! } ;;
        *) break ;;
    esac
done

if ! printf '%s\n' "$subject" | grep -qE "$commit_regex" &&
    ! printf '%s\n' "$subject" | grep -qE "$merge_regex"; then
    echo "$error_msg" >&2
    exit 1
fi
