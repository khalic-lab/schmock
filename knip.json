{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": [".claude/**", ".agents/**", "examples/**"],
  "ignoreDependencies": ["@tsconfig/strictest", "bun-types"],
  "workspaces": {
    ".": {
      "entry": [
        "benchmarks/*.ts",
        "scripts/*.{js,ts}"
      ],
      "ignoreDependencies": [
        "@angular/common",
        "@angular/compiler",
        "rxjs"
      ]
    },
    "packages/core": {
      "entry": ["src/types.ts!"]
    },
    "packages/angular": {
      "ignoreDependencies": [
        "@angular/platform-browser",
        "@angular/platform-browser-dynamic",
        "@schmock/openapi"
      ]
    },
    "packages/schmock": {
      "ignoreDependencies": [
        "@schmock/faker",
        "@schmock/validation",
        "@schmock/query",
        "@schmock/openapi",
        "@schmock/cli"
      ]
    },
    "scripts/integration-tests/fixtures/*": {
      "entry": ["smoke.test.{ts,tsx}"]
    },
    "scripts/integration-tests/fixtures/react": {
      "ignoreDependencies": ["react-dom"]
    },
    "scripts/smoke-tests/fixtures/*": {
      "entry": ["smoke.{ts,tsx}"]
    },
    "scripts/smoke-tests/fixtures/angular": {
      "entry": ["smoke.ts"],
      "ignoreDependencies": ["@angular/core"]
    },
    "scripts/smoke-tests/fixtures/react": {
      "entry": ["smoke.tsx"],
      "ignoreDependencies": ["@testing-library/react"]
    },
    "scripts/smoke-tests/fixtures/vue": {
      "entry": ["smoke.ts"],
      "ignoreDependencies": ["@vue/test-utils"]
    }
  }
}
